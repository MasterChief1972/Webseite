function openEditName() {
  switchToMain();
  document.getElementById('editFirstname').value = myFirstname || '';
  document.getElementById('editLastname').value  = myLastname  || '';
  document.getElementById('editNameErr').style.display = 'none';
  document.getElementById('editNameModal').style.display = 'flex';
}

function closeEditName() {
  document.getElementById('editNameModal').style.display = 'none';
}

document.getElementById('editNameModal').addEventListener('click', function(e) {
  if (e.target === this) { e.stopPropagation(); closeEditName(); }
});

async function saveEditName() {
  const first = document.getElementById('editFirstname').value.trim();
  const last  = document.getElementById('editLastname').value.trim();
  const errEl = document.getElementById('editNameErr');
  errEl.style.display = 'none';
  if (!first) { errEl.textContent = 'Bitte Vorname eingeben.'; errEl.style.display = ''; return; }
  if (!last)  { errEl.textContent = 'Bitte Nachname eingeben.'; errEl.style.display = ''; return; }

  const btn = document.querySelector('#editNameModal .profile-save-btn');
  btn.disabled = true; btn.textContent = '…';
  const res = await api('POST', '/api/profile/update_name', { firstname: first, lastname: last });
  btn.disabled = false; btn.textContent = '💾 Speichern';

  if (!res.ok) { errEl.textContent = res.error || 'Fehler.'; errEl.style.display = ''; return; }

  myFirstname = first; myLastname = last;
  const full = first + ' ' + last;
  const fn = document.getElementById('dropFullName');
  if (fn) fn.textContent = full;
  closeEditName();
}

function openDeleteProfile() {
  switchToMain();
  document.getElementById('deletePassword').value = '';
  document.getElementById('deleteProfileErr').style.display = 'none';
  document.getElementById('deleteProfileModal').style.display = 'flex';
}

function closeDeleteProfile() {
  document.getElementById('deleteProfileModal').style.display = 'none';
}

document.getElementById('deleteProfileModal').addEventListener('click', function(e) {
  if (e.target === this) { e.stopPropagation(); closeDeleteProfile(); }
});

async function confirmDeleteProfile() {
  const pw    = document.getElementById('deletePassword').value;
  const errEl = document.getElementById('deleteProfileErr');
  errEl.style.display = 'none';
  if (!pw) { errEl.textContent = 'Bitte Passwort eingeben.'; errEl.style.display = ''; return; }

  const btn = document.querySelector('#deleteProfileModal .delete-confirm-btn');
  btn.disabled = true; btn.textContent = '…';
  const res = await api('POST', '/api/profile/delete', { password: pw });
  btn.disabled = false; btn.textContent = '🗑️ Konto löschen';

  if (!res.ok) { errEl.textContent = res.error || 'Fehler.'; errEl.style.display = ''; return; }
  closeDeleteProfile();
  await doLogout();
}

// =====================================================================
//  NUTZER BLOCKIEREN
// =====================================================================
let selectedBlockDays = 0;

function openBlockModal(userId, username) {
  document.getElementById('blockTargetId').value   = userId;
  document.getElementById('blockTargetName').textContent = username;
  document.getElementById('blockError').style.display   = 'none';
  document.getElementById('blockReason').value    = '';
  document.getElementById('blockCustomDays').value = '';
  document.getElementById('blockCustomWrap').style.display = 'none';
  selectedBlockDays = 0;
  // Reset active buttons
  document.querySelectorAll('.block-day-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('blockUserModal').classList.add('visible');
}

function closeBlockModal() {
  document.getElementById('blockUserModal').classList.remove('visible');
}

document.getElementById('blockUserModal').addEventListener('click', function(e) {
  if (e.target === this) closeBlockModal();
});

function selectBlockDays(days) {
  document.querySelectorAll('.block-day-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  if (days === 0) {
    document.getElementById('blockCustomWrap').style.display = '';
    selectedBlockDays = 0;
  } else {
    document.getElementById('blockCustomWrap').style.display = 'none';
    selectedBlockDays = days;
  }
}

async function submitBlock() {
  const userId = document.getElementById('blockTargetId').value;
  const reason = document.getElementById('blockReason').value.trim();
  const errEl  = document.getElementById('blockError');
  errEl.style.display = 'none';

  let days = selectedBlockDays;
  if (days === 0) {
    days = parseInt(document.getElementById('blockCustomDays').value);
    if (!days || days < 1) {
      errEl.textContent = 'Bitte Anzahl Tage eingeben (mind. 1).';
      errEl.style.display = '';
      return;
    }
  }
  if (!days) {
    errEl.textContent = 'Bitte eine Sperrdauer auswählen.';
    errEl.style.display = '';
    return;
  }

  const btn = document.querySelector('.block-submit-btn');
  btn.disabled = true; btn.textContent = '…';
  const res = await api('POST', '/api/admin/block_user', { user_id: userId, days, reason });
  btn.disabled = false; btn.textContent = '🚫 Sperren';

  if (!res.ok) { errEl.textContent = res.error; errEl.style.display = ''; return; }
  closeBlockModal();
  await loadAdminDashboard();
}

async function unblockUser(userId) {
  if (!confirm('Sperre aufheben?')) return;
  const res = await api('POST', '/api/admin/unblock_user', { user_id: userId });
  if (!res.ok) { alert('Fehler: ' + res.error); return; }
  await loadAdminDashboard();
}


