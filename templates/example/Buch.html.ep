function openForgotModal() {
  switchToMain();
  document.getElementById('forgotUser').value     = '';
  document.getElementById('forgotNewPass').value  = '';
  document.getElementById('forgotNewPass2').value = '';
  document.getElementById('forgotErr').style.display = 'none';
  document.getElementById('forgotOk').style.display  = 'none';
  document.getElementById('forgotModal').style.display = 'flex';
  setTimeout(() => document.getElementById('forgotUser').focus(), 100);
}

function closeForgotModal() {
  document.getElementById('forgotModal').style.display = 'none';
  document.getElementById('authOverlay').classList.add('visible');
  switchForm('login');
}

async function submitForgotPassword() {
  const username = document.getElementById('forgotUser').value.trim();
  const newPass  = document.getElementById('forgotNewPass').value;
  const newPass2 = document.getElementById('forgotNewPass2').value;
  const errEl    = document.getElementById('forgotErr');
  const okEl     = document.getElementById('forgotOk');
  errEl.style.display = 'none';
  okEl.style.display  = 'none';

  if (!username)         { errEl.textContent = 'Bitte Benutzernamen eingeben.';        errEl.style.display = ''; return; }
  if (newPass.length < 4){ errEl.textContent = 'Passwort mindestens 4 Zeichen.';      errEl.style.display = ''; return; }
  if (newPass !== newPass2){ errEl.textContent = 'Passwörter stimmen nicht überein.'; errEl.style.display = ''; return; }

  const btn = document.getElementById('forgotBtn');
  btn.disabled = true; btn.textContent = '⏳ Wird geändert…';
  const res = await api('POST', '/api/auth/reset_password', { username, new_password: newPass });
  btn.disabled = false; btn.textContent = '💾 Passwort ändern';

  if (!res.ok) { errEl.textContent = res.error || 'Fehler beim Ändern.'; errEl.style.display = ''; return; }

  okEl.textContent = '✅ Passwort erfolgreich geändert!';
  okEl.style.display = '';
  setTimeout(() => { closeForgotModal(); }, 1800);
}

