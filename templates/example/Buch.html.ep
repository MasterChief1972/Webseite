  }
}


// =====================================================================
//  NUTZUNGSBEDINGUNGEN SYSTEM
// =====================================================================
let termsMode = 'view'; // 'register', 'reaccept', 'view'
let currentTermsVersion = '';

// Load terms from server and open modal
function showTermsNow(mode) {
  // Synchronous - shows modal immediately without waiting for API
  termsMode = mode || 'view';
  document.getElementById('termsModal').style.display = 'flex';
  document.getElementById('termsContent').innerHTML =
    '<p style="color:#bbb;font-style:italic;text-align:center;padding:40px 20px">⏳ Nutzungsbedingungen werden geladen…</p>';

  const acceptRow = document.getElementById('termsAcceptRow');
  const acceptBtn = document.getElementById('termsAcceptBtn');
  const cancelBtn = document.getElementById('termsCancelBtn');
  const chk       = document.getElementById('termsCheckbox');

  if (mode === 'register' || mode === 'reaccept') {
    acceptRow.style.display = '';
    acceptBtn.style.display = '';
    chk.checked = false;
    acceptBtn.disabled = true;
    cancelBtn.textContent = mode === 'reaccept' ? 'Später' : 'Abbrechen';
  } else {
    acceptRow.style.display = 'none';
    acceptBtn.style.display = 'none';
    cancelBtn.textContent = 'Schließen';
  }

  // Load content async after modal is already visible
  api('GET', '/api/terms').then(res => {
    currentTermsVersion = (res && res.version) ? res.version : '';
    function renderLine(line) {
      if (line.startsWith('## '))
        return '<h4 style="color:#005a9c;font-size:14px;font-weight:800;margin:16px 0 6px;padding-bottom:4px;border-bottom:1px solid #e8eef5">' + esc(line.slice(3)) + '</h4>';
      if (line.trim() === '') return '<div style="height:6px"></div>';
      return '<div>' + esc(line) + '</div>';
    }
    const text = res && res.content;
    document.getElementById('termsContent').innerHTML = text
      ? text.split('\n').map(renderLine).join('')
      : '<p style="color:#888;font-style:italic;text-align:center;padding:20px">Noch keine Nutzungsbedingungen eingetragen.</p>';
    document.getElementById('termsVersionLabel').textContent =
      res && res.version ? 'Version ' + res.version : '';
  }).catch(() => {
    document.getElementById('termsContent').innerHTML =
      '<p style="color:#cc0000;text-align:center;padding:20px">⚠️ Fehler beim Laden.</p>';
  });
}

async function openTermsModal(mode) {
  showTermsNow(mode);
}

async function openTermsModal_full(mode) {
  termsMode = mode || 'view';

  // Open modal immediately — don't wait for content
  document.getElementById('termsModal').style.display = 'flex';
  document.getElementById('termsContent').innerHTML =
    '<p style="color:#bbb;font-style:italic;text-align:center;padding:20px">⏳ Wird geladen…</p>';

  // Show/hide accept controls
  const acceptRow = document.getElementById('termsAcceptRow');
  const acceptBtn = document.getElementById('termsAcceptBtn');
  const cancelBtn = document.getElementById('termsCancelBtn');
  const chk       = document.getElementById('termsCheckbox');

  if (mode === 'register' || mode === 'reaccept') {
    acceptRow.style.display = '';
    acceptBtn.style.display = '';
    chk.checked = false;
    acceptBtn.disabled = true;
    cancelBtn.textContent = mode === 'reaccept' ? 'Später' : 'Abbrechen';
  } else {
    acceptRow.style.display = 'none';
    acceptBtn.style.display = 'none';
    cancelBtn.textContent = 'Schließen';
  }

  // Load content
  try {
    const res = await api('GET', '/api/terms');
    currentTermsVersion = (res && res.version) ? res.version : '';

    function renderTermsContent(text) {
      if (!text) return '<p style="color:#888;font-style:italic;text-align:center;padding:20px">Es wurden noch keine Nutzungsbedingungen hinterlegt.</p>';
      return text.split('\n').map(line => {
        if (line.startsWith('## ')) return '<h4 style="color:#005a9c;font-size:14px;font-weight:800;margin:16px 0 6px;padding-bottom:4px;border-bottom:1px solid #e8eef5">' + esc(line.slice(3)) + '</h4>';
        if (line.trim() === '')    return '<div style="height:6px"></div>';
        return '<div>' + esc(line) + '</div>';
      }).join('');
    }

    document.getElementById('termsContent').innerHTML = renderTermsContent(res && res.content);
    document.getElementById('termsVersionLabel').textContent =
      res && res.version ? 'Version ' + res.version + (res.updated_at ? ' · ' + res.updated_at : '') : '';
  } catch(e) {
    document.getElementById('termsContent').innerHTML =
      '<p style="color:#cc0000;text-align:center;padding:20px">⚠️ Fehler beim Laden. Bitte nochmal versuchen.</p>';
  }
}

function closeTermsModal() {
  document.getElementById('termsModal').style.display = 'none';
}

function toggleTermsBtn() {
  const chk = document.getElementById('termsCheckbox');
  document.getElementById('termsAcceptBtn').disabled = !chk.checked;
}

async function acceptTerms() {
  if (termsMode === 'register') {
    document.getElementById('rTerms').checked = true;
    document.getElementById('termsModal').classList.remove('visible');
    // authOverlay is already visible in background
    return;
  }

  if (termsMode === 'reaccept') {
    const res = await api('POST', '/api/terms/accept', { version: currentTermsVersion });
    if (res.ok) {
      userNeedsTermsAcceptance = false;
      document.getElementById('termsModal').classList.remove('visible');
      document.getElementById('termsReacceptBanner').classList.add('hidden');
      renderGrid(); // re-render so borrow buttons appear
    }
  }
}

// Check on login if user needs to re-accept terms
let userNeedsTermsAcceptance = false;

async function checkTermsAcceptance() {
  if (!me || me.toLowerCase() === 'administrator') return;
  const res = await api('GET', '/api/terms/check');
  if (res.ok && res.needs_acceptance) {
    userNeedsTermsAcceptance = true;
    document.getElementById('termsReacceptBanner').classList.remove('hidden');
    // Open terms modal immediately on login if not yet accepted
    openTermsModal('reaccept');
  } else {
    userNeedsTermsAcceptance = false;
    document.getElementById('termsReacceptBanner').classList.add('hidden');
  }
}


// =====================================================================
//  ADMIN NUTZUNGSBEDINGUNGEN EDITOR
// =====================================================================
async function loadAdminTermsEditor() {
  try {
    const res = await api('GET', '/api/terms');
    if (res.ok && res.version) {
      document.getElementById('termsAdminVersion').value = res.version;
      document.getElementById('termsAdminContent').value = res.content || '';
      livePreviewTerms();
    } else {
      // No terms yet — editor is empty and ready to fill in
      document.getElementById('termsAdminVersion').value = '';
      document.getElementById('termsAdminContent').value = '';
      document.getElementById('termsLivePreview').innerHTML =
        '<p style="color:#bbb;font-style:italic;text-align:center;margin-top:60px">← Text links eingeben um Vorschau zu sehen</p>';
    }
  } catch(e) {
    // Network error — still show the editor
    console.warn('Terms load error:', e);
  }
  // Load stats (non-blocking)
  try { await loadTermsStats(); } catch(e) {}
}

function livePreviewTerms() {
  const text    = document.getElementById('termsAdminContent').value;
  const version = document.getElementById('termsAdminVersion').value;
  const preview = document.getElementById('termsLivePreview');
  const verEl   = document.getElementById('termsPreviewVersion');

  if (verEl) verEl.textContent = version ? 'v' + version : '';

  if (!text.trim()) {
    preview.innerHTML = '<p style="color:#bbb;font-style:italic;text-align:center;margin-top:80px">← Text links eingeben um Vorschau zu sehen</p>';
    return;
  }

  preview.innerHTML = text.split('\n').map(line => {
    if (line.startsWith('## '))
      return `<div style="color:#005a9c;font-size:14px;font-weight:800;margin:16px 0 5px;padding-bottom:4px;border-bottom:1px solid #e8eef5">${esc(line.slice(3))}</div>`;
    if (line.trim() === '')
      return '<div style="height:8px"></div>';
    return `<div style="margin-bottom:2px">${esc(line)}</div>`;
  }).join('');
}

async function loadTermsStats() {
  const res = await api('GET', '/api/admin/terms/stats');
  const el  = document.getElementById('termsStatsContent');
  if (!el) return;

  if (!res.ok || !res.version) {
    el.innerHTML = '<span style="color:#bbb;font-style:italic">Noch keine Nutzungsbedingungen gespeichert.</span>';
    return;
  }

  const pct = res.total_users > 0 ? Math.round((res.accepted / res.total_users) * 100) : 0;
  el.innerHTML = `
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;margin-bottom:16px">
      <div style="background:#f4f6f9;border-radius:10px;padding:16px;text-align:center">
        <div style="font-size:2rem;font-weight:800;color:#005a9c">${res.accepted || 0}</div>
        <div style="font-size:12px;color:#888;margin-top:2px;font-weight:700">Zugestimmt</div>
      </div>
      <div style="background:#f4f6f9;border-radius:10px;padding:16px;text-align:center">
        <div style="font-size:2rem;font-weight:800;color:#cc0000">${(res.total_users || 0) - (res.accepted || 0)}</div>
        <div style="font-size:12px;color:#888;margin-top:2px;font-weight:700">Ausstehend</div>
      </div>
      <div style="background:#f4f6f9;border-radius:10px;padding:16px;text-align:center">
        <div style="font-size:2rem;font-weight:800;color:#2a8a2a">${pct}%</div>
        <div style="font-size:12px;color:#888;margin-top:2px;font-weight:700">Akzeptanzrate</div>
      </div>
    </div>
    <div style="background:#f4f6f9;border-radius:8px;padding:12px 16px;font-size:13px;color:#555">
      Aktuelle Version: <strong>v${esc(res.version)}</strong> · Gespeichert am: ${esc(res.updated_at || '—')}
    </div>
    ${res.pending_users && res.pending_users.length ? `
    <div style="margin-top:14px">
      <div style="font-size:12px;font-weight:800;color:#555;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px">Noch nicht zugestimmt:</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        ${res.pending_users.map(u => {
          const fn = [u.firstname, u.lastname].filter(Boolean).join(' ') || u.username;
          return `<span style="background:#fff0f0;color:#cc0000;border:1px solid #ffcccc;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700">
            ${esc(fn)}
          </span>`;
        }).join('')}
      </div>
    </div>` : ''}
  `;
}

async function saveAdminTerms() {
  const version    = document.getElementById('termsAdminVersion').value.trim();
  const agbContent = document.getElementById('termsAdminContent').value.trim();
  const errEl      = document.getElementById('termsAdminErr');
  const okEl       = document.getElementById('termsAdminOk');
  errEl.style.display = 'none';
  okEl.style.display  = 'none';

  if (!version)    { errEl.textContent = 'Bitte eine Version eingeben (z. B. 1.0).'; errEl.style.display = ''; return; }
  if (!agbContent) { errEl.textContent = 'Bitte den AGB-Text eingeben.';             errEl.style.display = ''; return; }

  const btn = event.target;
  btn.disabled = true; btn.textContent = '…';
  const res = await api('POST', '/api/admin/terms/save', { version, content: agbContent });
  btn.disabled = false; btn.textContent = '💾 Speichern';

  if (!res.ok) { errEl.textContent = res.error || 'Fehler beim Speichern.'; errEl.style.display = ''; return; }
  okEl.innerHTML = '✅ AGB gespeichert! Alle Nutzer müssen beim nächsten Login erneut zustimmen.';
  okEl.style.display = '';
  setTimeout(() => { okEl.style.display = 'none'; }, 5000);
  try { await loadTermsStats(); } catch(e) {}
}


// =====================================================================
//  ISBN SUCHE (Open Library)
// =====================================================================
// =====================================================================
//  BUCH SUCHE (ISBN + Titel)
// =====================================================================
let searchTab = 'isbn'; // 'isbn' or 'title'

function switchSearchTab(tab) {
  searchTab = tab;
  const isbnWrap  = document.getElementById('isbnInputWrap');
  const titleWrap = document.getElementById('titleInputWrap');
  const tabIsbn   = document.getElementById('searchTabIsbn');
  const tabTitle  = document.getElementById('searchTabTitle');
  const resList   = document.getElementById('titleResultsList');
  const resEl     = document.getElementById('isbnResult');

  resEl.style.display  = 'none';
  resList.style.display = 'none';

  if (tab === 'isbn') {
    isbnWrap.style.display  = '';
    titleWrap.style.display = 'none';
    tabIsbn.style.background  = '#007bff'; tabIsbn.style.color  = '#fff';
    tabTitle.style.background = '#f0f8ff'; tabTitle.style.color = '#007bff';
  } else {
    isbnWrap.style.display  = 'none';
    titleWrap.style.display = '';
    tabTitle.style.background = '#007bff'; tabTitle.style.color  = '#fff';
    tabIsbn.style.background  = '#f0f8ff'; tabIsbn.style.color  = '#007bff';
    document.getElementById('titleSearchInput').focus();
  }
}

// Shared helper: fill form from Open Library book data object
function fillFormFromBook(book, isbnRaw) {
  const title    = book.title || '';
  const authors  = book.authors ? book.authors.map(a => a.name).join(', ') : '';
  const year     = book.publish_date ? (book.publish_date.match(/\d{4}/)?.[0] || '') : '';
  const pages    = book.number_of_pages ? String(book.number_of_pages) : '';
  const subject  = book.subjects ? (book.subjects[0]?.name || '') : '';
  const coverUrl = book.cover?.large || book.cover?.medium || book.cover?.small || null;

  if (title)   document.getElementById('abTitle').value  = title;
  if (authors) document.getElementById('abAuthor').value = authors;
  if (year)    document.getElementById('abYear').value   = year;
  if (pages)   document.getElementById('abPages').value  = pages;
  if (isbnRaw) document.getElementById('abIsbn').value   = isbnRaw;

  // Genre matching
  if (subject) {
    const genreMap = {
      'fiction': 'Roman', 'fantasy': 'Fantasy', 'mystery': 'Krimi',
      'thriller': 'Thriller', 'horror': 'Horror', 'romance': 'Liebesroman',
      'science fiction': 'Wissenschaft', 'biography': 'Biografie',
      'history': 'Geschichte', 'philosophy': 'Philosophie',
      'adventure': 'Abenteuer', 'humor': 'Humor', 'classic': 'Klassiker'
    };
    const sub = subject.toLowerCase();
    for (const [key, val] of Object.entries(genreMap)) {
      if (sub.includes(key)) {
        const sel = document.getElementById('abGenre');
        if (Array.from(sel.options).find(o => o.value === val)) { sel.value = val; break; }
      }
    }
  }

  // Cover preview
  if (coverUrl) {
    document.getElementById('abCoverWrap').style.display = '';
    document.getElementById('abCoverUrl').value = coverUrl;
    const prev = document.getElementById('abCoverPreview');
    prev.src = coverUrl; prev.style.display = 'block';
  }

  return { title, authors };
}

// Call after fillFormFromBook to set language from Open Library data
function autoFillLanguage(bookData) {
  if (!bookData) return;
  // OL uses language codes like {key: '/languages/ger'}
  const langs = bookData.languages || [];
  for (const l of langs) {
    const code = (l.key || '').replace('/languages/', '');
    const map2 = { 'ger':'de','eng':'en','fre':'fr','spa':'es','ita':'it',
                   'rus':'ru','jpn':'ja','chi':'zh','ara':'ar','tur':'tr',
                   'dut':'nl','pol':'pl','por':'pt' };
    const iso = map2[code] || code;
    if (LANG_MAP[iso]) { setLanguageField(iso); break; }
  }
}

// Router: decides which search to run
function doBookSearch() {
  if (searchTab === 'isbn') searchByIsbn();
  else searchByTitle();
}

// ── ISBN search ──────────────────────────────────────────────────────
async function searchByIsbn() {
  const raw   = document.getElementById('isbnSearchInput').value.trim();
  const isbn  = raw.replace(/[^0-9Xx]/g, ''); // keep only digits and X
  const resEl = document.getElementById('isbnResult');
  const btn   = document.getElementById('isbnSearchBtn');

  resEl.style.display = 'none';
  resEl.className = 'isbn-result';

  if (!isbn) {
    resEl.textContent = 'Bitte eine ISBN eingeben.';
    resEl.className  += ' err'; resEl.style.display = ''; return;
  }

  btn.disabled = true; btn.textContent = '⏳ Suche…';
  try {
    let found = false;

    // 1. Try Open Library
    const r = await fetch(`https://openlibrary.org/api/books?bibkeys=ISBN:${isbn}&format=json&jscmd=data`);
    const d = await r.json();
    const olBook = d[`ISBN:${isbn}`];

    if (olBook) {
      const { title, authors } = fillFormFromBook(olBook, raw);
      resEl.innerHTML = `✅ Gefunden (Open Library): <strong>${esc(title)}</strong>${authors?' von '+esc(authors):''}.`;
      resEl.className += ' ok'; resEl.style.display = '';
      found = true;
    }

    // 2. Fallback: Google Books (better for German books)
    if (!found) {
      const r2 = await fetch(`https://www.googleapis.com/books/v1/volumes?q=isbn:${isbn}`);
      const d2 = await r2.json();
      if (d2.items && d2.items.length) {
        const vi = d2.items[0].volumeInfo;
        const title   = vi.title || '';
        const authors = (vi.authors || []).join(', ');
        const year    = vi.publishedDate ? vi.publishedDate.slice(0,4) : '';
        const pages   = vi.pageCount ? String(vi.pageCount) : '';
        const desc    = vi.description ? vi.description.slice(0,500) : '';
        const img     = vi.imageLinks;
        const coverUrl = img ? (img.large || img.medium || img.thumbnail || null) : null;

        if (title)    document.getElementById('abTitle').value  = title;
        if (authors)  document.getElementById('abAuthor').value = authors;
        if (year)     document.getElementById('abYear').value   = year;
        if (pages)    document.getElementById('abPages').value  = pages;
        if (desc)     document.getElementById('abDesc').value   = desc;
        document.getElementById('abIsbn').value = raw;

        if (coverUrl) {
          document.getElementById('abCoverWrap').style.display = '';
          document.getElementById('abCoverUrl').value = coverUrl;
          const prev = document.getElementById('abCoverPreview');
          prev.src = coverUrl; prev.style.display = 'block';
        }

        resEl.innerHTML = `✅ Gefunden (Google Books): <strong>${esc(title)}</strong>${authors?' von '+esc(authors):''}.`;
        resEl.className += ' ok'; resEl.style.display = '';
        found = true;
      }
    }

    if (!found) {
      resEl.textContent = '❌ Kein Buch mit dieser ISBN gefunden. Bitte manuell ausfüllen.';
      resEl.className  += ' err'; resEl.style.display = '';
    }
  } catch(e) {
    resEl.textContent = '⚠️ Netzwerkfehler. Bitte Verbindung prüfen.';
    resEl.className  += ' err'; resEl.style.display = '';
  }
  btn.disabled = false; btn.textContent = '🔍 Suchen';
}

// ── Title search ─────────────────────────────────────────────────────
// ── Search helpers ──────────────────────────────────────────────────

// Normalize a result into our internal format
function normalizeBook(src, source) {
  return {
    title:   src.title || '',
    authors: src.authors || [],
    year:    src.year   || '',
    pages:   src.pages  || '',
    isbn:    src.isbn   || null,
    cover:   src.cover  || null,
    subject: src.subject|| '',
    lang:    src.lang   || '',
    source:  source,
    raw:     src.raw,
  };
}

// Open Library search
async function searchOpenLibrary(query) {
  const q   = encodeURIComponent(query);
  const url = `https://openlibrary.org/search.json?q=${q}&limit=12&fields=title,author_name,first_publish_year,isbn,number_of_pages_median,cover_i,subject,language`;
  const r   = await fetch(url);
  const d   = await r.json();
  return (d.docs || []).map(doc => normalizeBook({
    title:   doc.title,
    authors: doc.author_name || [],
    year:    doc.first_publish_year ? String(doc.first_publish_year) : '',
    pages:   doc.number_of_pages_median ? String(doc.number_of_pages_median) : '',
    isbn:    doc.isbn ? doc.isbn[0] : null,
    cover:   doc.cover_i ? `https://covers.openlibrary.org/b/id/${doc.cover_i}-S.jpg` : null,
    lang:    (doc.language || []).includes('ger') ? 'de' : '',
    raw:     doc,
  }, 'openlibrary'));
}

// Google Books search (sehr gute deutsche Abdeckung)
async function searchGoogleBooks(query) {
  const q   = encodeURIComponent(query);
  const url = `https://www.googleapis.com/books/v1/volumes?q=${q}&maxResults=12&printType=books&langRestrict=de`;
  const r   = await fetch(url);
  const d   = await r.json();
  return ((d.items || [])).map(item => {
    const vi  = item.volumeInfo || {};
    const img = vi.imageLinks;
    const cover = img ? (img.smallThumbnail || img.thumbnail || null) : null;
    const isbn  = (vi.industryIdentifiers || []).find(x => x.type === 'ISBN_13' || x.type === 'ISBN_10');
    return normalizeBook({
      title:   vi.title || '',
      authors: vi.authors || [],
      year:    vi.publishedDate ? vi.publishedDate.slice(0,4) : '',
      pages:   vi.pageCount ? String(vi.pageCount) : '',
      isbn:    isbn ? isbn.identifier : null,
      cover:   cover,
      lang:    vi.language === 'de' ? 'de' : vi.language || '',
      subject: (vi.categories || []).join(', '),
      raw:     vi,
    }, 'google');
  });
}

// Merge + deduplicate + score results from multiple sources
function mergeAndScore(results, query) {
  const seen = new Set();
  const merged = [];
  for (const book of results) {
    const key = (book.title + '|' + (book.authors[0]||'')).toLowerCase().trim();
    if (seen.has(key)) continue;
    seen.add(key);
    // Score
    let score = 0;
    if (book.cover)  score += 3;
    if (book.isbn)   score += 2;
    if (book.lang === 'de') score += 3;
    if (book.pages)  score += 1;
    if (book.source === 'google') score += 1; // Google has better German coverage
    const t  = book.title.toLowerCase();
    const ql = query.toLowerCase();
    if (t === ql)              score += 15;
    else if (t.startsWith(ql)) score += 8;
    else if (t.includes(ql))   score += 3;
    merged.push({ ...book, score });
  }
  return merged.sort((a,b) => b.score - a.score);
}

// Main title search function
async function searchByTitle() {
  const query = document.getElementById('titleSearchInput').value.trim();
  const resEl = document.getElementById('isbnResult');
  const list  = document.getElementById('titleResultsList');
  const btn   = document.getElementById('titleSearchBtn');

  resEl.style.display = 'none';
  list.style.display  = 'none';
  list.innerHTML      = '';
  resEl.className     = 'isbn-result';

  if (!query) {
    resEl.textContent = 'Bitte Titel, Autor oder Stichwort eingeben.';
    resEl.className += ' err'; resEl.style.display = ''; return;
  }

  btn.disabled = true; btn.textContent = '⏳ Suche…';

  try {
    // Search both sources in parallel
    const [olResults, gbResults] = await Promise.allSettled([
      searchOpenLibrary(query),
      searchGoogleBooks(query),
    ]);

    const ol = olResults.status === 'fulfilled' ? olResults.value : [];
    const gb = gbResults.status === 'fulfilled' ? gbResults.value : [];

    // Google Books first (better German), then Open Library
    const all    = [...gb, ...ol];
    const scored = mergeAndScore(all, query);

    if (!scored.length) {
      resEl.textContent = '❌ Keine Bücher gefunden. Versuche einen anderen Begriff.';
      resEl.className += ' err'; resEl.style.display = '';
      btn.disabled = false; btn.textContent = '🔍 Suchen'; return;
    }

    const top = scored.slice(0, 15);
    list.style.display = 'block';
    list.innerHTML = top.map((book, i) => {
      const t     = book.title || '?';
      const a     = book.authors.join(', ') || '?';
      const y     = book.year  || '';
      const pages = book.pages ? book.pages + ' S.' : '';
      const srcBadge = book.source === 'google'
        ? '<span style="font-size:9px;color:#4285f4;background:#e8f0fe;padding:2px 5px;border-radius:3px;flex-shrink:0">Google</span>'
        : '<span style="font-size:9px;color:#888;background:#f0f0f0;padding:2px 5px;border-radius:3px;flex-shrink:0">OL</span>';
      return `<div onclick="selectTitleResult(${i})"
        style="display:flex;align-items:center;gap:12px;padding:10px 14px;cursor:pointer;border-bottom:1px solid #f0f0f0;transition:background 0.15s"
        onmouseover="this.style.background='#f0f8ff'" onmouseout="this.style.background=''">
        <div style="width:36px;height:52px;border-radius:5px;background:#dde8f5;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.1rem">
          ${book.cover ? `<img src="${esc(book.cover)}" style="width:36px;height:52px;object-fit:cover" onerror="this.style.display='none'">` : '📚'}
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:800;color:#222;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            ${book.lang==='de' ? '🇩🇪 ' : ''}${esc(t)}
          </div>
          <div style="font-size:11px;color:#666;margin-top:1px">${esc(a)}</div>
          <div style="font-size:11px;color:#aaa">${y}${y && pages ? ' · ' : ''}${pages}</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:3px;align-items:flex-end;flex-shrink:0">
          ${srcBadge}
          ${book.isbn ? '<span style="font-size:9px;color:#2a8a2a;background:#eafaf0;padding:2px 5px;border-radius:3px">ISBN ✓</span>' : ''}
        </div>
      </div>`;
    }).join('');

    list._docs = top;

    const srcInfo = [ol.length ? `Open Library: ${ol.length}` : '', gb.length ? `Google Books: ${gb.length}` : ''].filter(Boolean).join(' · ');
    resEl.innerHTML = `🔍 ${top.length} Ergebnisse (${srcInfo})`;
    resEl.className += ' ok'; resEl.style.display = '';

  } catch(e) {
    resEl.textContent = '⚠️ Netzwerkfehler. Bitte Verbindung prüfen.';
    resEl.className += ' err'; resEl.style.display = '';
  }
  btn.disabled = false; btn.textContent = '🔍 Suchen';
}

async function selectTitleResult(idx) {
  const book  = document.getElementById('titleResultsList')._docs[idx];
  const list  = document.getElementById('titleResultsList');
  const resEl = document.getElementById('isbnResult');

  list.style.display = 'none';
  resEl.className    = 'isbn-result';
  resEl.innerHTML    = '⏳ Lade Details…';
  resEl.className   += ' ok'; resEl.style.display = '';

  let filled = false;

  // Strategy 1: If Google Books source, use its data directly (already detailed)
  if (book.source === 'google' && book.raw) {
    const vi = book.raw;
    const title   = vi.title || book.title;
    const authors = (vi.authors || book.authors).join(', ');
    const year    = vi.publishedDate ? vi.publishedDate.slice(0,4) : book.year;
    const pages   = vi.pageCount ? String(vi.pageCount) : book.pages;
    const desc    = vi.description || '';
    const isbn13  = (vi.industryIdentifiers || []).find(x => x.type==='ISBN_13');
    const isbn10  = (vi.industryIdentifiers || []).find(x => x.type==='ISBN_10');
    const isbn    = isbn13 ? isbn13.identifier : (isbn10 ? isbn10.identifier : null);
    const img     = vi.imageLinks;
    const coverUrl = img ? (img.large || img.medium || img.thumbnail || null) : null;

    if (title)    document.getElementById('abTitle').value  = title;
    if (authors)  document.getElementById('abAuthor').value = authors;
    if (year)     document.getElementById('abYear').value   = year;
    if (pages)    document.getElementById('abPages').value  = pages;
    if (isbn)     document.getElementById('abIsbn').value   = isbn;
    if (desc)     document.getElementById('abDesc').value   = desc.slice(0, 500);

    // Genre from categories
    if (vi.categories && vi.categories.length) {
      const genreMap = {'Juvenile':'Roman','Fiction':'Roman','Fantasy':'Fantasy','Mystery':'Krimi',
        'Thriller':'Thriller','Horror':'Horror','Romance':'Liebesroman','Science':'Wissenschaft',
        'Biography':'Biografie','History':'Geschichte','Philosophy':'Philosophie','Adventure':'Abenteuer'};
      const cat = vi.categories[0];
      for (const [k,v] of Object.entries(genreMap)) {
        if (cat.includes(k)) {
          const sel = document.getElementById('abGenre');
          if (Array.from(sel.options).find(o=>o.value===v)) { sel.value=v; break; }
        }
      }
    }

    if (coverUrl) {
      document.getElementById('abCoverWrap').style.display = '';
      document.getElementById('abCoverUrl').value = coverUrl;
      const prev = document.getElementById('abCoverPreview');
      prev.src = coverUrl; prev.style.display = 'block';
    }
    if (vi.language) setLanguageField(vi.language);

    resEl.innerHTML = `✅ <strong>${esc(title)}</strong>${authors?' von '+esc(authors):''} — Felder prüfen & speichern.`;
    filled = true;
  }

  // Strategy 2: Try Open Library ISBN lookup for extra details
  if (!filled && book.isbn) {
    try {
      const r = await fetch(`https://openlibrary.org/api/books?bibkeys=ISBN:${book.isbn}&format=json&jscmd=data`);
      const d = await r.json();
      const ol = d[`ISBN:${book.isbn}`];
      if (ol) {
        const { title, authors } = fillFormFromBook(ol, book.isbn);
        resEl.innerHTML = `✅ <strong>${esc(title)}</strong>${authors?' von '+esc(authors):''} — Felder prüfen & speichern.`;
        filled = true;
      }
    } catch(e) {}
  }

  // Strategy 3: Use whatever data we already have
  if (!filled) {
    const title   = book.title || '';
    const authors = book.authors.join(', ');
    if (title)   document.getElementById('abTitle').value  = title;
    if (authors) document.getElementById('abAuthor').value = authors;
    if (book.year)  document.getElementById('abYear').value  = book.year;
    if (book.pages) document.getElementById('abPages').value = book.pages;
    if (book.isbn)  document.getElementById('abIsbn').value  = book.isbn;
    if (book.cover) {
      document.getElementById('abCoverWrap').style.display = '';
      document.getElementById('abCoverUrl').value = book.cover.replace('-S.jpg', '-M.jpg');
      const prev = document.getElementById('abCoverPreview');
      prev.src = book.cover.replace('-S.jpg', '-M.jpg'); prev.style.display = 'block';
    }
    resEl.innerHTML = `✅ <strong>${esc(title)}</strong>${authors?' von '+esc(authors):''} — Felder prüfen & speichern.`;
  }

  resEl.className = 'isbn-result ok'; resEl.style.display = '';
}


// =====================================================================
//  BÜCHER-EINSTELLUNGEN
// =====================================================================
let borrowSettings = { max_books: 3, max_days: 30, min_days: 1 };

async function loadBooksSettings() {
  const res = await api('GET', '/api/admin/settings');
  if (!res.ok) return;
  document.getElementById('settingMaxBooks').value = res.max_books || 3;
  document.getElementById('settingMaxDays').value  = res.max_days  || 30;
  document.getElementById('settingMinDays').value  = res.min_days  || 1;
  updateSettingsPreview(res.max_books, res.max_days, res.min_days);
}

function updateSettingsPreview(mb, md, mi) {
  const pb = document.getElementById('previewMaxBooks');
  const pd = document.getElementById('previewMaxDays');
  const pm = document.getElementById('previewMinDays');
  if (pb) pb.textContent = mb;
  if (pd) pd.textContent = md;
  if (pm) pm.textContent = mi;
}

async function saveBooksSettings() {
  const max_books = parseInt(document.getElementById('settingMaxBooks').value);
  const max_days  = parseInt(document.getElementById('settingMaxDays').value);
  const min_days  = parseInt(document.getElementById('settingMinDays').value);
  const errEl = document.getElementById('settingsErr');
  const okEl  = document.getElementById('settingsOk');
  errEl.style.display = 'none'; okEl.style.display = 'none';

  if (!max_books||max_books<1) { errEl.textContent='Max. Bücher mind. 1.'; errEl.style.display=''; return; }
  if (!max_days||max_days<1)   { errEl.textContent='Max. Tage mind. 1.';   errEl.style.display=''; return; }
  if (!min_days||min_days<1)   { errEl.textContent='Min. Tage mind. 1.';   errEl.style.display=''; return; }
  if (min_days>max_days)       { errEl.textContent='Min. Tage darf nicht größer als Max. Tage sein.'; errEl.style.display=''; return; }

  const btn = event.target;
  btn.disabled = true; btn.textContent = '…';
  const res = await api('POST', '/api/admin/settings/save', { max_books, max_days, min_days });
  btn.disabled = false; btn.textContent = '💾 Einstellungen speichern';

  if (!res.ok) { errEl.textContent = res.error||'Fehler.'; errEl.style.display=''; return; }
  borrowSettings = { max_books, max_days, min_days };
  okEl.textContent = '✅ Gespeichert!';
  okEl.style.display = '';
  setTimeout(() => { okEl.style.display='none'; }, 3000);
  updateSettingsPreview(max_books, max_days, min_days);
}


// =====================================================================
//  ADMIN DASHBOARD NAVIGATION
// =====================================================================
function openAdminDashboard() {
  // Close dropdown
  const menu = document.getElementById('userDropdownMenu');
  const arrow = document.getElementById('dropArrow');
  if (menu)  menu.style.display   = 'none';
  if (arrow) arrow.style.transform = '';

  // Switch views
  document.getElementById('main').style.display           = 'none';
  document.getElementById('adminDashboard').style.display = 'block';

  // Update dropdown buttons
  document.getElementById('dropAdminBtn').style.display = 'none';
  document.getElementById('dropBackBtn').style.display  = 'flex';

  // Load dashboard content
  loadBooks().then(() => loadAdminDashboard());
}

function closeAdminDashboard() {
  // Close dropdown
  const menu = document.getElementById('userDropdownMenu');
  const arrow = document.getElementById('dropArrow');
  if (menu)  menu.style.display   = 'none';
  if (arrow) arrow.style.transform = '';

  // Switch back to main
  document.getElementById('adminDashboard').style.display = 'none';
  document.getElementById('main').style.display           = '';

  // Update dropdown buttons
  document.getElementById('dropAdminBtn').style.display = 'flex';
  document.getElementById('dropBackBtn').style.display  = 'none';

  // Refresh book grid
  renderGrid();
}


// Map language codes to German labels for auto-fill
const LANG_MAP = {
  'de': 'Deutsch', 'en': 'Englisch', 'fr': 'Französisch',
  'es': 'Spanisch', 'it': 'Italienisch', 'ru': 'Russisch',
  'ja': 'Japanisch', 'zh': 'Chinesisch', 'ar': 'Arabisch',
  'tr': 'Türkisch', 'nl': 'Niederländisch', 'pl': 'Polnisch',
  'pt': 'Portugiesisch'
};

function setLanguageField(langCode) {
  const label = LANG_MAP[langCode] || '';
  const sel   = document.getElementById('abLanguage');
  if (!sel || !label) return;
  const opt = Array.from(sel.options).find(o => o.value === label);
  if (opt) sel.value = label;
  else { sel.value = 'Sonstige'; }
}

// Switch from admin dashboard to main view
function switchToMain() {
  const dash = document.getElementById('adminDashboard');
  if (dash && dash.style.display === 'block') {
    dash.style.display = 'none';
    document.getElementById('main').style.display = '';
    const adminBtn = document.getElementById('dropAdminBtn');
    const backBtn  = document.getElementById('dropBackBtn');
    if (adminBtn) adminBtn.style.display = 'flex';
    if (backBtn)  backBtn.style.display  = 'none';
  }
}

// =====================================================================
//  START
// =====================================================================
// Show loading state until books arrive
document.getElementById('grid').innerHTML = '<div class="empty-grid"><span class="icon">⏳</span><p>Wird geladen…</p></div>';

// Session prüfen (nach Seiten-Reload) — kein forciertes Login-Overlay mehr
api('GET', '/api/me').then(async res => {
  if (res.ok) {
    setLoggedIn(res.username, res.is_admin, res.firstname, res.lastname);
    await loadData();
  }
}).catch(() => {});

// Bücher aus DB laden
loadBooks();

// Ausleih-Einstellungen
api('GET','/api/settings').then(r => { if(r.ok) borrowSettings = r; });

document.getElementById('searchQ').addEventListener('input', renderGrid);
document.getElementById('sortSel').addEventListener('change', renderGrid);
</script>

<!--
==========================================================================
  📋 DATENBANK-SETUP — Bücher-Tabelle für SQLite
==========================================================================

Führe diese SQL-Befehle einmalig in deiner SQLite-Datenbank aus
(z. B. mit: sqlite3 deine_datenbank.db < setup_books.sql)

CREATE TABLE IF NOT EXISTS books (
  id          TEXT PRIMARY KEY,      -- z.B. 'b0', 'b1', ...
  title       TEXT NOT NULL,
  author      TEXT NOT NULL,
  genre       TEXT,
  rating      REAL DEFAULT 0,
  year        INTEGER,
  pages       INTEGER,               -- NEU: Seitenanzahl
  isbn        TEXT,                  -- NEU: ISBN-Nummer
  description TEXT                   -- NEU: Kurzbeschreibung
);

-- Beispieldaten einfügen:
INSERT OR IGNORE INTO books VALUES
  ('b0',  'Der Alchemist',                           'Paulo Coelho',              'Abenteuer',  4.8, 1988, 208,  '978-0-06-231500-7', 'Ein Hirt aus Andalusien folgt seinem Traum und reist durch die Wüste auf der Suche nach einem Schatz — und findet sich selbst.'),
  ('b1',  '1984',                                    'George Orwell',             'Dystopie',   4.7, 1949, 328,  '978-0-45-228423-4', 'In einem totalitären Überwachungsstaat kämpft Winston Smith still gegen das System des Großen Bruders.'),
  ('b2',  'Harry Potter und der Stein der Weisen',   'J.K. Rowling',              'Fantasy',    4.9, 1997, 335,  '978-0-74-753269-6', 'Ein Waisenkind entdeckt an seinem elften Geburtstag, dass es ein Zauberer ist, und tritt in die Hogwarts-Schule für Hexerei und Zauberei ein.'),
  ('b3',  'Die Verwandlung',                         'Franz Kafka',               'Klassiker',  4.5, 1915, 96,   '978-0-48-629030-7', 'Gregor Samsa erwacht eines Morgens als riesiges Ungeziefer und muss erleben, wie seine Familie mit dieser Situation umgeht.'),
  ('b4',  'Das Parfum',                              'Patrick Süskind',           'Thriller',   4.6, 1985, 320,  '978-3-25-710236-3', 'Jean-Baptiste Grenouille besitzt einen übernatürlichen Geruchssinn und wird besessen davon, den perfekten Duft zu schaffen.'),
  ('b5',  'Der Herr der Ringe',                      'J.R.R. Tolkien',            'Fantasy',    4.9, 1954, 1216, '978-0-61-896441-0', 'Frodo Beutlin bricht mit einer Gefährtenschaft auf, um den Einen Ring zu vernichten und Mittelerde vor dem dunklen Herrscher Sauron zu retten.'),
  ('b6',  'Faust',                                   'Johann Wolfgang von Goethe','Klassiker',  4.4, 1808, 464,  '978-3-15-000001-7', 'Der Gelehrte Faust schließt einen Pakt mit dem Teufel Mephisto, um alle Weisheit und Lust der Welt zu erfahren.'),
  ('b7',  'Siddharta',                               'Hermann Hesse',             'Philosophie',4.7, 1922, 152,  '978-0-81-120068-1', 'Der junge Brahmane Siddharta verlässt sein privilegiertes Leben auf der Suche nach Erleuchtung und innerem Frieden.'),
  ('b8',  'Der kleine Prinz',                        'Antoine de Saint-Exupéry',  'Philosophie',4.8, 1943, 96,   '978-3-73-630001-1', 'Ein kleiner Prinz reist von Asteroid zu Asteroid und lernt durch seine Begegnungen die wesentlichen Dinge des Lebens kennen.'),
  ('b9',  'Dracula',                                 'Bram Stoker',               'Horror',     4.5, 1897, 418,  '978-0-14-143984-3', 'Der transsilvanische Graf Dracula versucht, von seinem Schloss nach England zu ziehen, um neues Blut zu finden.'),
  ('b10', 'Sherlock Holmes',                         'Arthur Conan Doyle',        'Krimi',      4.7, 1887, 307,  '978-0-14-243723-0', 'Der Meisterdetektiv Sherlock Holmes löst zusammen mit seinem Freund Dr. Watson die rätselhaftesten Verbrechen Londons.'),
  ('b11', 'Die unendliche Geschichte',               'Michael Ende',              'Fantasy',    4.8, 1979, 428,  '978-3-52-220554-3', 'Der Bücherwurm Bastian entdeckt ein magisches Buch, das ihn in das Reich Phantásien hineinzieht, wo er selbst zur Hauptfigur wird.'),
  ('b12', 'Krabat',                                  'Otfried Preußler',          'Fantasy',    4.6, 1971, 234,  '978-3-52-317702-0', 'Der Waisenjunge Krabat tritt als Lehrling in eine Mühle ein, die sich als Schule für Schwarze Magie entpuppt.'),
  ('b13', 'Buddenbrooks',                            'Thomas Mann',               'Klassiker',  4.6, 1901, 736,  '978-3-59-690440-7', 'Der Aufstieg und Niedergang einer Lübecker Kaufmannsfamilie über vier Generationen hinweg.'),
  ('b14', 'Der Prozess',                             'Franz Kafka',               'Klassiker',  4.5, 1925, 248,  '978-0-80-521061-4', 'Josef K. wird eines Morgens verhaftet, ohne zu wissen warum, und kämpft gegen ein undurchdringliches Justizsystem.'),
  ('b15', 'Homo Faber',                              'Max Frisch',                'Roman',      4.3, 1957, 204,  '978-3-51-822600-9', 'Der rational denkende Ingenieur Walter Faber macht eine Reise, die sein gesamtes Weltbild erschüttert.'),
  ('b16', 'Der Steppenwolf',                         'Hermann Hesse',             'Roman',      4.4, 1927, 231,  '978-0-31-266809-5', 'Harry Haller, ein Einzelgänger zwischen bürgerlicher Welt und einem wilden inneren Wolf, sucht nach dem Sinn seines Lebens.'),
  ('b17', 'Moby Dick',                               'Herman Melville',           'Abenteuer',  4.3, 1851, 720,  '978-0-14-243723-4', 'Kapitän Ahab führt sein Schiff und seine Besatzung in einer obsessiven Jagd auf den weißen Wal Moby Dick.'),
  ('b18', 'Effi Briest',                             'Theodor Fontane',           'Klassiker',  4.3, 1895, 340,  '978-3-15-006316-1', 'Die junge Effi heiratet einen deutlich älteren Landrat und leidet in ihrer Ehe, bis eine alte Affäre ihr Leben zerstört.');

-- Backend-Endpoints:
-- GET  /api/books         → { ok:1, books:[{id,title,author,genre,rating,year,pages,isbn,description},...] }
-- POST /api/books/add     → params: title,author,genre,year,pages,rating,isbn,description
--                           Erzeugt automatisch eine neue ID (z.B. 'b19')
--                           → { ok:1, book_id:'b19' }
-- POST /api/books/update  → params: book_id + alle anderen Felder (wie add)
--                           → { ok:1 }
-- POST /api/books/delete  → params: book_id
--                           → { ok:1 }
-- Alle 3 Endpoints NUR für eingeloggten 'admin'-User erlaubt (Session prüfen)!
==========================================================================
-->

</body>
</html>