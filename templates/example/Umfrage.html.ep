<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alexs Seite-Umfrage</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f8f9fa;
            --card-bg: #ffffff;
            --accent-color: #0d6efd;
            --text-main: #212529;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', Roboto, sans-serif;
        }

        .col-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        @media (max-width: 768px) {
            .col-container {
                grid-template-columns: 1fr;
            }
        }

        .col-section {
            background-color: var(--card-bg);
            padding: 2rem;
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            min-height: 200px;
        }

        h1 {
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: #333;
            border-bottom: 2px solid var(--accent-color);
            display: inline-block;
            padding-bottom: 5px;
        }

        .navbar-brand, .nav-item {
            cursor: pointer;
        }
        .custom-input {
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #ddd;
        width: 100%;
        margin-bottom: 1rem;
        transition: border-color 0.2s;
        }

        .custom-input:focus {
        outline: none;
        border-color: var(--accent-color);
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
        }


        .list-group-item {
        border: none;
        padding-left: 0;
        background: transparent;
        }

        .img-fluid-custom {
        border-radius: 10px;
        margin-top: 10px;
        }
    </style>
</head>
<body>
    <main>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow">
            <div class="container-fluid">
                <a onclick="window.location.href='/'" class="navbar-brand fw-bold" href="#">Alexs Seite</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav01">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="nav01">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li onclick="window.location.href='/Witze'" class="nav-item"><a class="nav-link" href="#">Witze</a></li>
                        <li onclick="window.location.href='/Umfrage'" class="nav-item"><a class="nav-link" href="#">Umfrage</a></li>
                    </ul>
                    <form class="d-flex" role="search">
                        <input class="form-control me-2 rounded-pill" type="search" placeholder="Suchen...">
                    </form>
                </div>
            </div>
        </nav><section class="col-container">
        <div class="text-center">
          <h1>Umfrage</h1>
        </div>
        
        <div class="mb-4">
          <h5 class="fw-bold">Wie heist es?</h5>
          <label id ="antw_grade_kurve">Antwort</label>
          <div id="wahl_nutella" class="form-check mb-2">
            <input class="form-check-input" type="radio" name="grade_kurve" id="n1">
            <label class="form-check-label" for="n1">Die Grade Kurve</label>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="grade_kurve" id="n2">
            <label class="form-check-label" for="n2">Der Grade Kurve</label>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="grade_kurve" id="n3">
            <label class="form-check-label" for="n2">Das Grade Kurve</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="grade_kurve" id="n4">
            <label class="form-check-label" for="n3">Ich enthalte mich!</label>
          </div>
        </div>

        <div class="">
          <div class="form-floating mb-3">
            <input placeholder="Vorname" type="text" class="form-control" id="vorname">
            <label for="vorname">Vorname</label>
        </div>
          <div class="form-floating mb-3">
            <input placeholder="Nachname" type="text" class="form-control" id="nachname">
            <label for="nachname">Nachname</label>
        </div>
          <div class="form-floating mb-3">
            <input placeholder="E-Mail" type="text" class="form-control" id="e-mail">
            <label for="e-mail">E-mail</label>
        </div>
        <div class="d-flex justify-content-end mb-5">
          <button type="button" class="btn btn-outline-primary btn-sm" onclick="nachricht();">Absnden</button>
        </div>
    </div>
  </main>

  <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/jquery-4.0.0.min.js"></script>
  <script>
    function nachricht () {
      if (confirm("Bist du sicher das du die Antwort senden wilst?")) {
        alert("Vielen dank ;)");
      } else {
        alert('Bitte bearbeite deine antwort');
      }
    }
  </script>
</body>
</html>